<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
<!--

 **********************************************************************************************************************
 ** arm64 twin of ../headlessunattend.xml — identical settings, processorArchitecture="arm64" throughout instead of  **
 ** amd64. Windows Setup matches <component> blocks by processorArchitecture against the image being installed and   **
 ** silently SKIPS any that don't match (added 2026-08-18, sweep item 3 — the amd64-only original was never applied  **
 ** on an arm64 install at all: not just the OpenSSH/RDP/autologon bits, but DiskConfiguration and ImageInstall too,  **
 ** since Microsoft-Windows-Setup is itself an architecture-tagged component in the windowsPE pass). Real arm64       **
 ** Windows Server media confirmed available (A64FRE build, efi/boot/bootaa64.efi present) before writing this.       **
 **                                                                                                                   **
 ** VirtIO guest driver injection: NOT part of this unattend.xml, a manual WinPE step.                               **
 **                                                                                                                  **
 ** Sample answer file for headless deployment                                                                       **
 ** 1. Edit answer file to include your information; password, product key, language etc.                            **
 ** 2. Run setup using the /unattend:answer_file parameter, where answer_file is the XML path, e.g.                  **
 **    setup.exe /unattend:\\server\share\unattend.xml /noreboot                                                     **
 ** 3. See the Windows Automated Installation Kit for additional guidance on unattendedinstallation and headless     **
 **    deployment.                                                                                                   **
 **                                                                                                                  **
 ** Windows has no "in-target" equivalent for running an MSI against an unbooted, offline image (Windows Installer   **
 ** needs a live OS). RunSynchronousCommand's ordering relative to the built-in image-apply step is undocumented by  **
 ** Microsoft, it's deliberately NOT automated in this XML. Run manually in WinPE, after setup.exe /noreboot applies **
 ** this XML's image to C:\ and before rebooting into it:                                                            **
 **                                                                                                                  **
 ** set "SERVER=192.168.139.50"                                                                                      **
 ** set "BASE=http://%SERVER%/windows"                                                                               **
 ** set "SCRIPTS=C:\Windows\Setup\Scripts"                                                                           **
 **                                                                                                                  **
 ** certutil.exe -urlcache -f "%BASE%/unattend/headlessunattend-arm64.xml" X:\headlessunattend.xml                   **
 ** Y:\Sources\setup.exe /unattend:X:\headlessunattend.xml /noreboot                                                 **
 **                                                                                                                  **
 ** mkdir "%SCRIPTS%"                                                                                                **
 ** dism /Image:C:\ /Add-Driver /Driver:X:\Tools\Drivers /Recurse                                                    **
 ** certutil.exe -urlcache -f "%BASE%/SetupComplete.cmd" "%SCRIPTS%\SetupComplete.cmd"                               **
 ** certutil.exe -urlcache -f "%BASE%/Detect-Platform.cmd" "%SCRIPTS%\Detect-Platform.cmd"                           **
 ** certutil.exe -urlcache -f "%BASE%/Install-OpenSSH.ps1" "%SCRIPTS%\Install-OpenSSH.ps1"                           **
 **                                                                                                                  **
 ** Source: X:\Tools\Drivers (virtio-win driver files, staged in WinPE). Target: C:\ (the OS this XML just applied). **
 **********************************************************************************************************************


  NOTE: This sample will wipe disk 0 and clear all data on the disk.
-->
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>netsh advfirewall firewall set rule group="Remote Desktop" new enable=yes</CommandLine>
                    <Order>1</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>dism /online /add-capability /capabilityname:OpenSSH.Server~~~~0.0.1.0 /source:D:\ /limitaccess</CommandLine>
                    <Order>2</Order>
                </SynchronousCommand>
                <!-- Add-WindowsCapability -Online -Name 'OpenSSH.Client~~~~0.0.1.0' -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand QQBkAGQALQBXAGkAbgBkAG8AdwBzAEMAYQBwAGEAYgBpAGwAaQB0AHkAIAAtAE8AbgBsAGkAbgBlACAALQBOAGEAbQBlACAAJwBPAHAAZQBuAFMAUwBIAC4AQwBsAGkAZQBuAHQAfgB+AH4AfgAwAC4AMAAuADEALgAwACcA</CommandLine>
                    <Order>3</Order>
                </SynchronousCommand>
                <!-- Set-Service -Name sshd -StartupType 'Automatic' -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand UwBlAHQALQBTAGUAcgB2AGkAYwBlACAALQBOAGEAbQBlACAAcwBzAGgAZAAgAC0AUwB0AGEAcgB0AHUAcABUAHkAcABlACAAJwBBAHUAdABvAG0AYQB0AGkAYwAnAA==</CommandLine>
                    <Order>4</Order>
                </SynchronousCommand>
                <!-- Start-Service sshd -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand UwB0AGEAcgB0AC0AUwBlAHIAdgBpAGMAZQAgAHMAcwBoAGQA</CommandLine>
                    <Order>5</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>timeout /t 120 /nobreak</CommandLine>
                    <Order>6</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>netsh advfirewall firewall set rule group="OpenSSH Server" new enable=yes</CommandLine>
                    <Order>7</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>sc config sshd start= auto</CommandLine>
                    <Order>8</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>sc start sshd</CommandLine>
                    <Order>9</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>shutdown /L</CommandLine>
                    <Order>10</Order>
                </SynchronousCommand>
            </FirstLogonCommands>
            <UserAccounts>
                <AdministratorPassword>
                    <Value>Password1!</Value>
                    <PlainText>true</PlainText>
                </AdministratorPassword>
            </UserAccounts>
        </component>
    </settings>
    <settings pass="specialize">
        <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <fDenyTSConnections>false</fDenyTSConnections>
        </component>
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <AutoLogon>
                <Password>
                    <Value>Password1!</Value>
                    <PlainText>true</PlainText>
                </Password>
                <Enabled>true</Enabled>
                <LogonCount>2</LogonCount>
                <Username>Administrator</Username>
            </AutoLogon>
            <ComputerName>*<!-- * GENERATES A RANDOM NAME, MODIFY TO SPECIFY A NAME --></ComputerName>
        </component>
        <component name="Microsoft-Windows-TerminalServices-RDP-WinStationExtensions" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <UserAuthentication>0</UserAuthentication>
        </component>
    </settings>
    <settings pass="windowsPE">
        <component name="Microsoft-Windows-Setup" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <DiskConfiguration>
                <Disk wcm:action="add">
                    <CreatePartitions>
                        <CreatePartition wcm:action="add">
                            <Order>1</Order>
                            <Extend>true</Extend>
                            <Type>Primary</Type>
                        </CreatePartition>
                    </CreatePartitions>
                    <WillWipeDisk>true</WillWipeDisk>
                    <DiskID>1</DiskID>
                </Disk>
                <WillShowUI>Never</WillShowUI>
            </DiskConfiguration>
            <ImageInstall>
                <OSImage>
                    <InstallTo>
                        <DiskID>1</DiskID>
                        <PartitionID>1</PartitionID>
                    </InstallTo>
                    <WillShowUI>OnError</WillShowUI>
                    <InstallFrom>
                    </InstallFrom>
                </OSImage>
            </ImageInstall>
            <UserData>
                <ProductKey>
                    <WillShowUI>Always</WillShowUI>
                </ProductKey>
                <AcceptEula>true</AcceptEula>
            </UserData>
            <EnableNetwork>false<!-- CHANGE TO TRUE IF USING A NETWORK SHARE FOR UNATTEND OR DRIVERS --></EnableNetwork>
        </component>
        <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <SetupUILanguage>
                <UILanguage>en-US</UILanguage>
            </SetupUILanguage>
            <UILanguage>en-GB</UILanguage>
        </component>
<!--
        <component name="Microsoft-Windows-PnpCustomizationsWinPE" processorArchitecture="arm64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <DriverPaths>
                <PathAndCredentials wcm:action="add" wcm:keyValue="1">
                    <Path>INSERT DRIVER PATH</Path>
                </PathAndCredentials>
            </DriverPaths>
        </component>
-->
    </settings>
</unattend>
