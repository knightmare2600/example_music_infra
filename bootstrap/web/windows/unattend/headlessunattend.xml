<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
<!--

 **********************************************************************************************************************
 ** amd64-only. arm64 targets need ./headlessunattend-arm64.xml instead — identical settings, but with               **
 ** processorArchitecture="arm64" on every <component>. Windows Setup matches components by processorArchitecture    **
 ** against the image being installed and silently SKIPS any that don't match (found 2026-08-18, sweep item 3 —      **
 ** this file was never applying ANY of its settings on an arm64 install, not just the OpenSSH/RDP/autologon bits    **
 ** but DiskConfiguration and ImageInstall too, since Microsoft-Windows-Setup is itself architecture-tagged).         **
 **                                                                                                                  **
 ** FIXED 2026-09-03 (Robert: "it complains about the disk, specifically the DiskConfiguration section"): DiskID was **
 ** "1" in both <Disk> and <ImageInstall><InstallTo> — confirmed against Microsoft's own docs that DiskID is         **
 ** 0-indexed ("0 specifies the first disk, 1 the second, and so on"), so this targeted the SECOND physical disk,    **
 ** which doesn't exist on a single-disk target — directly contradicted this file's own comment below ("wipe disk   **
 ** 0"). Unchanged since the very first commit that added this file (2026-06-28); if it worked before it was on a   **
 ** machine that genuinely had 2+ disks, not a regression. Also added the missing <ModifyPartitions> block —         **
 ** Microsoft's own reference example pairs every <CreatePartitions> with a <ModifyPartitions> that actually applies **
 ** <Format>/<Letter> to the partition just created; without it the partition existed but was never formatted, so   **
 ** ImageInstall had nowhere valid to install onto even with DiskID correct. Both fixed to DiskID=0 + NTFS/C: format. **
 **                                                                                                                  **
 ** VirtIO guest driver injection: NOT part of this unattend.xml, a manual WinPE step.                               **
 **                                                                                                                  **
 ** Sample answer file for headless deployment                                                                       **
 ** 1. Edit answer file to include your information; password, product key, language etc.                            **
 ** 2. Run setup using the /unattend:answer_file parameter, where answer_file is the XML path, e.g.                  **
 **    setup.exe /unattend:\\server\share\unattend.xml /noreboot                                                     **
 ** 3. See the Windows Automated Installation Kit for additional guidance on unattendedinstallation and headless     **
 **    deployment.                                                                                                   **
 **                                                                                                                  **
 ** Windows has no "in-target" equivalent for running an MSI against an unbooted, offline image (Windows Installer   **
 ** needs a live OS). RunSynchronousCommand's ordering relative to the built-in image-apply step is undocumented by  **
 ** Microsoft, it's deliberately NOT automated in this XML. Run manually in WinPE, after setup.exe /noreboot applies **
 ** this XML's image to C:\ and before rebooting into it:                                                            **
 **                                                                                                                  **
 ** set "SERVER=192.168.139.50"                                                                                      **
 ** set "BASE=http://%SERVER%/windows"                                                                               **
 ** set "SCRIPTS=C:\Windows\Setup\Scripts"                                                                           **
 **                                                                                                                  **
 ** certutil.exe -urlcache -f "%BASE%/unattend/headlessunattend.xml" X:\headlessunattend.xml                         **
 ** Y:\Sources\setup.exe /unattend:X:\headlessunattend.xml /noreboot                                                 **
 **                                                                                                                  **
 ** mkdir "%SCRIPTS%"                                                                                                **
 ** dism /Image:C:\ /Add-Driver /Driver:X:\Tools\Drivers /Recurse                                                    **
 ** certutil.exe -urlcache -f "%BASE%/SetupComplete.cmd" "%SCRIPTS%\SetupComplete.cmd"                               **
 ** certutil.exe -urlcache -f "%BASE%/Detect-Platform.cmd" "%SCRIPTS%\Detect-Platform.cmd"                           **
 ** certutil.exe -urlcache -f "%BASE%/Install-OpenSSH.ps1" "%SCRIPTS%\Install-OpenSSH.ps1"                           **
 **                                                                                                                  **
 ** Source: X:\Tools\Drivers (virtio-win driver files, staged in WinPE). Target: C:\ (the OS this XML just applied). **
 **********************************************************************************************************************
	

  NOTE: This sample will wipe disk 0 and clear all data on the disk. 
-->
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>netsh advfirewall firewall set rule group="Remote Desktop" new enable=yes</CommandLine>
                    <Order>1</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>dism /online /add-capability /capabilityname:OpenSSH.Server~~~~0.0.1.0 /source:D:\ /limitaccess</CommandLine>
                    <Order>2</Order>
                </SynchronousCommand>
                <!-- Add-WindowsCapability -Online -Name 'OpenSSH.Client~~~~0.0.1.0' -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand QQBkAGQALQBXAGkAbgBkAG8AdwBzAEMAYQBwAGEAYgBpAGwAaQB0AHkAIAAtAE8AbgBsAGkAbgBlACAALQBOAGEAbQBlACAAJwBPAHAAZQBuAFMAUwBIAC4AQwBsAGkAZQBuAHQAfgB+AH4AfgAwAC4AMAAuADEALgAwACcA</CommandLine>
                    <Order>3</Order>
                </SynchronousCommand>
                <!-- Set-Service -Name sshd -StartupType 'Automatic' -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand UwBlAHQALQBTAGUAcgB2AGkAYwBlACAALQBOAGEAbQBlACAAcwBzAGgAZAAgAC0AUwB0AGEAcgB0AHUAcABUAHkAcABlACAAJwBBAHUAdABvAG0AYQB0AGkAYwAnAA==</CommandLine>
                    <Order>4</Order>
                </SynchronousCommand>
                <!-- Start-Service sshd -->
                <SynchronousCommand wcm:action="add">
                    <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand UwB0AGEAcgB0AC0AUwBlAHIAdgBpAGMAZQAgAHMAcwBoAGQA</CommandLine>
                    <Order>5</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>timeout /t 120 /nobreak</CommandLine>
                    <Order>6</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>netsh advfirewall firewall set rule group="OpenSSH Server" new enable=yes</CommandLine>
                    <Order>7</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>sc config sshd start= auto</CommandLine>
                    <Order>8</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>sc start sshd</CommandLine>
                    <Order>9</Order>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <CommandLine>shutdown /L</CommandLine>
                    <Order>10</Order>
                </SynchronousCommand>
            </FirstLogonCommands>
            <UserAccounts>
                <AdministratorPassword>
                    <Value>Password1!</Value>
                    <PlainText>true</PlainText>
                </AdministratorPassword>
            </UserAccounts>
        </component>
    </settings>
    <settings pass="specialize">
        <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <fDenyTSConnections>false</fDenyTSConnections>
        </component>
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <AutoLogon>
                <Password>
                    <Value>Password1!</Value>
                    <PlainText>true</PlainText>
                </Password>
                <Enabled>true</Enabled>
                <LogonCount>2</LogonCount>
                <Username>Administrator</Username>
            </AutoLogon>
            <ComputerName>*<!-- * GENERATES A RANDOM NAME, MODIFY TO SPECIFY A NAME --></ComputerName>
        </component>
        <component name="Microsoft-Windows-TerminalServices-RDP-WinStationExtensions" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <UserAuthentication>0</UserAuthentication>
        </component>
    </settings>
    <settings pass="windowsPE">
        <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <DiskConfiguration>
                <Disk wcm:action="add">
                    <CreatePartitions>
                        <CreatePartition wcm:action="add">
                            <Order>1</Order>
                            <Extend>true</Extend>
                            <Type>Primary</Type>
                        </CreatePartition>
                    </CreatePartitions>
                    <ModifyPartitions>
                        <ModifyPartition wcm:action="add">
                            <Order>1</Order>
                            <PartitionID>1</PartitionID>
                            <Label>Windows</Label>
                            <Letter>C</Letter>
                            <Format>NTFS</Format>
                        </ModifyPartition>
                    </ModifyPartitions>
                    <WillWipeDisk>true</WillWipeDisk>
                    <DiskID>0</DiskID>
                </Disk>
                <WillShowUI>Never</WillShowUI>
            </DiskConfiguration>
            <ImageInstall>
                <OSImage>
                    <InstallTo>
                        <DiskID>0</DiskID>
                        <PartitionID>1</PartitionID>
                    </InstallTo>
                    <WillShowUI>OnError</WillShowUI>
                    <InstallFrom>
                    </InstallFrom>
                </OSImage>
            </ImageInstall>
            <UserData>
                <ProductKey>
                    <WillShowUI>Always</WillShowUI>
                </ProductKey>
                <AcceptEula>true</AcceptEula>
            </UserData>
            <EnableNetwork>false<!-- CHANGE TO TRUE IF USING A NETWORK SHARE FOR UNATTEND OR DRIVERS --></EnableNetwork>
        </component>
        <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <SetupUILanguage>
                <UILanguage>en-US</UILanguage>
            </SetupUILanguage>
            <UILanguage>en-GB</UILanguage>
        </component>
<!--
        <component name="Microsoft-Windows-PnpCustomizationsWinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <DriverPaths>
                <PathAndCredentials wcm:action="add" wcm:keyValue="1">
                    <Path>INSERT DRIVER PATH</Path>
                </PathAndCredentials>
            </DriverPaths>
        </component>
-->
    </settings>
</unattend>
