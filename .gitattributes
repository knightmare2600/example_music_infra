###############################################################################
# Example Music Infrastructure - Git Line Ending Policy
###############################################################################

# Default behaviour
* text=auto

###############################################################################
# Linux / Unix files (always LF)
###############################################################################

*.sh          text eol=lf
*.bash        text eol=lf
*.zsh         text eol=lf
*.py          text eol=lf
*.pl          text eol=lf

*.yml         text eol=lf
*.yaml        text eol=lf

*.cfg         text eol=lf
*.conf        text eol=lf
*.cnf         text eol=lf

*.ipxe        text eol=lf

*.service     text eol=lf
*.socket      text eol=lf
*.timer       text eol=lf
*.mount       text eol=lf
*.target      text eol=lf
*.path        text eol=lf
*.slice       text eol=lf
*.scope       text eol=lf
*.network     text eol=lf
*.netdev      text eol=lf
*.link        text eol=lf

*.rules       text eol=lf
*.env         text eol=lf

*.md          text eol=lf
*.txt         text eol=lf

###############################################################################
# Windows files (always CRLF)
###############################################################################

*.ps1         text eol=crlf
*.psm1        text eol=crlf
*.psd1        text eol=crlf

*.bat         text eol=crlf
*.cmd         text eol=crlf

*.reg         text eol=crlf
*.xaml        text eol=crlf
*.xml         text eol=crlf

*.inf         text eol=crlf
*.sif         text eol=crlf
*.unattend    text eol=crlf

###############################################################################
# Binary files (never modify line endings)
###############################################################################

*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.bmp         binary
*.ico         binary
*.svg         binary

*.pdf         binary
*.zip         binary
*.7z          binary
*.gz          binary
*.xz          binary
*.bz2         binary
*.tar         binary
*.tgz         binary
*.iso         binary

*.exe         binary
*.dll         binary
*.msi         binary

*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary

###############################################################################
# bootstrap/web/ boot assets -- git-lfs (2026-07-27)
###############################################################################
# By directory, not extension -- kernel binaries here are routinely
# extensionless by convention (vmlinuz, linux-x86_64, wimboot, bsd.rd),
# so filename-based rules would miss most of what actually needs tracking.
# Populated either by bootstrap/setup-workstation-{linux,macos}.sh /
# bootstrap/Setup-Workstation.ps1 (benarbejde/asset_manifest.json's
# real-upstream entries -- Spejder, klargoring, wimboot, Debian, OpenBSD,
# gparted) or dropped in by hand -- Robert's own custom builds with no
# upstream (Arch's airootfs), or third-party vendor downloads not worth a
# manifest entry (3cx/, supplied directly by Robert 2026-07-27; its kernel
# turned out to be genuine unmodified Debian Bookworm and lives at
# debian/bookworm/x86_64/linux instead, see menu.ipxe's :3cx-install comment).
# Either way, once a file lands under these paths it goes through LFS, not a
# plain git blob -- keeps this repo's normal git history small regardless of
# source. Existing tracked files under bootstrap/web/debian/ predate this
# rule and were NOT retroactively migrated (that rewrites git history -- a
# separate, more invasive decision, not bundled into this one).
#
# rockylinux/ deliberately NOT tracked here -- Robert deleted his local copy
# 2026-07-27, revisiting later. Re-add the rule when that work resumes.
#
# winpe/ is scoped to wimboot* ONLY, not the whole directory -- wimboot
# itself (github.com/ipxe/wimboot) is GPL2, no Microsoft code in it, fine to
# distribute. The actual WinPE .wim is NOT -- Robert confirmed 2026-07-27
# this repo cannot redistribute it (Microsoft ADK licensing). See
# .gitignore's matching exclusion for the hard technical guard against ever
# committing one by accident.
bootstrap/web/spejder/**             filter=lfs diff=lfs merge=lfs -text
bootstrap/web/proxmox/klargoring/**  filter=lfs diff=lfs merge=lfs -text
bootstrap/web/debian/**              filter=lfs diff=lfs merge=lfs -text
bootstrap/web/openbsd/**             filter=lfs diff=lfs merge=lfs -text
bootstrap/web/gparted/**             filter=lfs diff=lfs merge=lfs -text
bootstrap/web/winpe/**/wimboot*      filter=lfs diff=lfs merge=lfs -text
bootstrap/web/3cx/**                 filter=lfs diff=lfs merge=lfs -text
bootstrap/web/arch/**/airootfs.sfs   filter=lfs diff=lfs merge=lfs -text
bootstrap/web/arch/**/vmlinuz-linux  filter=lfs diff=lfs merge=lfs -text
bootstrap/web/arch/**/initramfs-linux* filter=lfs diff=lfs merge=lfs -text
