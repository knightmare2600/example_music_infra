#!/usr/bin/env bash
# .githooks/pre-commit
# Keeps a handful of served-copy files in sync with their real source of
# truth automatically: the source always wins, the served copy is
# overwritten to match and staged as part of the same commit. Two groups:
#
#   benarbejde/ -> bootstrap/web/proxmox/ (sites.csv, devices.csv,
#   address_policy.json, begyndelse.json, ad_forest.json, role_codes.csv) --
#   so the preseed web server can serve them during PXE installs, and so
#   create-vm.py's own script-directory search path finds role_codes.csv when
#   run standalone from this served copy (added 2026-07-26, alongside
#   create-vm.py's ROLE_CODES switching from a hardcoded dict to loading this
#   file). benarbejde/ is never hand-edited in the copy's location.
#
#   bootstrap/web/debian/late_command.sh -> bootstrap/web/late_command.sh --
#   was a symlink until 2026-07-11, replaced with a real synced copy for
#   cross-platform clones (symlinks don't survive Windows/macOS/Linux clones
#   reliably). Its only known consumer is bootstrap/web/lvm.seed's
#   http://.../late_command.sh fetch (the live preseed path,
#   bootstrap/web/debian/lvm-bios.seed/lvm-efi.seed, fetches
#   .../debian/late_command.sh directly and doesn't need this copy at all --
#   see the 2026-07-11 note in bootstrap/web/lvm.seed itself). Real edits
#   happen in debian/late_command.sh only.
#
# One-time setup (per clone):
#   git config core.hooksPath .githooks

set -euo pipefail

FAIL=0

sync_pair() {
    local src="$1"
    local dst="$2"

    if [[ ! -f "$src" ]]; then
        echo "  [!] Missing source of truth: ${src}"
        FAIL=1
        return
    fi

    if ! diff -q "$src" "$dst" > /dev/null 2>&1; then
        cp "$src" "$dst"
        git add "$dst"
        echo "  [i] Synced ${dst} from ${src}"
    fi
}

sync_from_source() {
    local name="$1"
    sync_pair "benarbejde/${name}" "bootstrap/web/proxmox/${name}"
}

sync_from_source "sites.csv"
sync_from_source "devices.csv"
sync_from_source "address_policy.json"
sync_from_source "begyndelse.json"
sync_from_source "ad_forest.json"
sync_from_source "role_codes.csv"

sync_pair "bootstrap/web/debian/late_command.sh" "bootstrap/web/late_command.sh"

if [[ $FAIL -ne 0 ]]; then
    echo ""
    echo "  Commit blocked — resolve the error above first."
    echo ""
    exit 1
fi
