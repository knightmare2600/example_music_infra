#!/usr/bin/env bash
# .githooks/pre-commit
# benarbejde/ is the single source of truth for sites.csv, devices.csv, and
# address_policy.json. bootstrap/web/proxmox/ only exists so the preseed web
# server can serve them during PXE installs -- it is never hand-edited.
# This hook keeps it in sync automatically: benarbejde/ always wins, the
# bootstrap/web/proxmox/ copy is overwritten to match and staged as part of
# the same commit.
#
# One-time setup (per clone):
#   git config core.hooksPath .githooks

set -euo pipefail

FAIL=0

sync_from_source() {
    local name="$1"
    local src="benarbejde/${name}"
    local dst="bootstrap/web/proxmox/${name}"

    if [[ ! -f "$src" ]]; then
        echo "  [!] Missing source of truth: ${src}"
        FAIL=1
        return
    fi

    if ! diff -q "$src" "$dst" > /dev/null 2>&1; then
        cp "$src" "$dst"
        git add "$dst"
        echo "  [i] Synced ${dst} from ${src}"
    fi
}

sync_from_source "sites.csv"
sync_from_source "devices.csv"
sync_from_source "address_policy.json"

if [[ $FAIL -ne 0 ]]; then
    echo ""
    echo "  Commit blocked — resolve the error above first."
    echo ""
    exit 1
fi
