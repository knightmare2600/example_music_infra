; ============================================================
; /etc/bind/db.192.168.139
; Example Music Limited -- provisioning network reverse zone
;
; Zone:    139.168.192.in-addr.arpa
; Covers:  192.168.139.0/24  (provisioning network)
; Source:  devices.csv (single source of truth)
; Server:  EXADNSVRK001 ({{ dns_ip }})
; Managed: Ansible bind9-dns.yml Play 2
; Generated: {{ ansible_date_time.iso8601 }}
;
; CLD BLACK SWAN:
;   192.168.139.0/24 is the provisioning network (the vRACK). It serves two purposes:
;
;   (a) vRACK-resident devices -- DNS/PRV/FWL-WAN, Site=VRK in devices.csv.
;       Rudder/WAC/PBX/DCs are CLD LAN-only (192.168.69.0/24) -- see db.192.168.69,
;       NOT this zone (an earlier version of this file wrongly duplicated them
;       here too, at the same host octets as their real LAN addresses -- a
;       copy-paste mistake, not a genuine second vRACK-side interface).
;
;   (b) FWL WAN addresses -- every site firewall has a WAN interface here.
;       Host octet = site subnet third octet (e.g. EDI .131 -> .139.131).
;       This is now the CANONICAL bare exafwl<site>001 name (Robert, 2026-07-26 --
;       matches Ansible's own inventory, which has always used this address under
;       the bare hostname; DNS previously disagreed and used it under a "-wan"
;       suffix instead, with the bare name pointing at the LAN face -- the LAN
;       face now lives under its own "-lan" suffix, see db.forward-zone.devices.j2
;       and db.site-reverse.devices.j2). CLD is unaffected -- its WAN face already
;       has its own distinct, real devices.csv-driven hostname (EXAFWLVRK001).
;
;   This zone is generated separately and NOT by the per-site loop.
;   CLD's own subnet is this zone -- there is no separate CLD site reverse.
; ============================================================

$ORIGIN 139.168.192.in-addr.arpa.
$TTL {{ zone_ttl }}

@   IN  SOA  {{ this_hostname }}.{{ domain }}.  hostmaster.{{ domain }}. (
              {{ zone_serial }}  ; serial
              3600       ; refresh
              900        ; retry
              604800     ; expire
              {{ zone_ttl }}        ; minimum
            )

@   IN  NS   {{ this_hostname }}.{{ domain }}.

; ── vRACK ancillary PTRs ─────────────────────────────────────
; Derived from all_devices (Site=VRK). Rudder/WAC/PBX/DCs are CLD LAN-only --
; see db.192.168.69 instead.
{% for dev in all_devices | selectattr('Site', 'equalto', 'VRK') | sort(attribute='full_ip') %}
{% set host_octet = dev.full_ip.split('.')[3] %}
{{ "%-5s" | format(host_octet) }} IN  PTR  {{ "%-50s" | format(dev.Hostname | lower + '.' + domain + '.') }} ; {{ dev.Notes }}
{% endfor %}

; ── FWL WAN PTR records (192.168.139.{octet} per site) ───────
; CLD special case: vRACK WAN comes from devices.csv (all_devices' EXAFWLVRK001 entry), not the
; CLD LAN octet -- CLD's own subnet is the LAN side, not the vRACK.
; Sorted by octet ascending. Non-CLD targets the bare exafwl<site>001 name, not "-wan" --
; matches Ansible's own inventory convention for this hostname (Robert, 2026-07-26).
{% set cld_wan_octet = (all_devices | selectattr('Hostname', 'equalto', 'EXAFWLVRK001') | map(attribute='full_ip') | first).split('.')[3] %}
{% for site in sites_raw.list
   | rejectattr('Site', 'equalto', 'BRD')
   | rejectattr('Site', 'equalto', 'Site')
   | rejectattr('Subnet', 'equalto', 'N/A')
   | sort(attribute='Subnet') %}
{% set octet = site.Subnet.split('.')[2] %}
{% if site.Site == 'CLD' %}
{{ "%-5s" | format(cld_wan_octet) }} IN  PTR  {{ "%-50s" | format('exafwlcld001-wan.' + domain + '.') }} ; CLD ({{ site.City }}) -- vRACK WAN (same interface as exafwlvrk001)
{% else %}
{{ "%-5s" | format(octet) }} IN  PTR  {{ "%-50s" | format('exafwl' + site.Site | lower + '001.' + domain + '.') }} ; {{ site.Site }} ({{ site.City }}) -- WAN/provisioning face
{% endif %}
{% endfor %}
