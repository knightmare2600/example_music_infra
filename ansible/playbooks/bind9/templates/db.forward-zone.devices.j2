; ============================================================
; /etc/bind/db.{{ domain }}
; Example Music Limited -- {{ domain }} forward zone
;
; Authoritative DNS: EXADNSVRK001 ({{ dns_ip }})
; Zone:              {{ domain }}
; Source:            devices.csv (single source of truth)
; Managed by:        Ansible bind9-dns.yml Play 2
; Generated:         {{ ansible_date_time.iso8601 }}
;
; A records are generated for every device with a HostOctet in devices.csv.
; Devices without a HostOctet (non-networked assets: vehicles, aircraft etc.)
; are emitted as comments so they remain documented without DNS resolution.
;
; A device whose Type has a non-empty entry in role_codes.csv's DNSAlias column also gets a
; CNAME for a friendly short name (e.g. SLT -> salt.{{ domain }} -> exasltcld001.{{ domain }}).
; Added 2026-07-20 -- see benarbejde/generate_inventory.py's TYPE_DNS_ALIAS. Only a couple of
; single-instance CLD-only services have one; most devices have none at all.
;
; CLD/VRK/FRD:
;   A forward zone is just hostname->IP; it doesn't care what subnet an A
;   record's IP is on (that's a reverse-zone concern, handled separately per
;   subnet in db.192.168.139/db.192.168.69/db.172.16.124). So CLD (its own
;   LAN, 192.168.69.0/24), VRK (the vRACK, 192.168.139.0/24) and FRD (the
;   Fredericia Havn vRACK stand-in, 172.16.124.0/24) all flow through the
;   same generic per-site loop below like any other site -- no special-casing
;   needed here at all (each site's octet is derived from its own devices'
;   real IPs already, not a sites.csv lookup, so this was never blocked on
;   VRK/CLD/FRD's absence from/oddities in sites_by_code).
;
; SOA serial format: YYYYMMDDnn
; TTL: {{ zone_ttl }}s -- short TTL for fast provisioning propagation.
;
; DO NOT EDIT this file by hand except to add one-off records at the bottom.
; Regenerate with: ansible-playbook bind9-dns.yml --tags zones-full,reload
; ============================================================

$ORIGIN {{ domain }}.
$TTL {{ zone_ttl }}

; ── SOA + NS ─────────────────────────────────────────────────
@   IN  SOA  {{ this_hostname }}.{{ domain }}.  hostmaster.{{ domain }}. (
              {{ zone_serial }}  ; serial   YYYYMMDDnn
              3600       ; refresh  1 hour
              900        ; retry    15 minutes
              604800     ; expire   1 week
              {{ zone_ttl }}        ; minimum  {{ zone_ttl }}s
            )

@   IN  NS   {{ this_hostname }}.{{ domain }}.

; ── FWL WAN addresses on provisioning network (192.168.139.{octet}) ──────────
; Each site firewall has a WAN interface on 192.168.139.0/24.
; Host octet = site subnet third octet. -wan suffix distinguishes from LAN face.
; CLD special case: vRACK WAN comes from devices.csv (all_devices' EXAFWLVRK001 entry), not the
; CLD LAN octet (.69) -- CLD's own subnet is the LAN side, not the vRACK.
{% set cld_wan_ip = all_devices | selectattr('Hostname', 'equalto', 'EXAFWLVRK001') | map(attribute='full_ip') | first %}
{% for site in sites_raw.list
   | rejectattr('Site', 'equalto', 'BRD')
   | rejectattr('Site', 'equalto', 'Site')
   | rejectattr('Subnet', 'equalto', 'N/A')
   | sort(attribute='Site') %}
{% set octet = site.Subnet.split('.')[2] %}
{% if site.Site == 'CLD' %}
{{ "%-45s" | format('exafwlcld001-wan') }} IN  A  {{ cld_wan_ip }}  ; CLD WAN face (same interface as exafwlvrk001)
{% else %}
{{ "%-45s" | format('exafwl' + site.Site | lower + '001-wan') }} IN  A  192.168.139.{{ octet }}   ; {{ site.Site }} WAN face on provisioning net
{% endif %}
{% endfor %}

; ── Per-site device records ───────────────────────────────────
; Grouped by site, sorted by HostOctet within each site.
; Devices without a HostOctet are documented as comments.
{% set site_codes = all_devices | map(attribute='Site') | unique | sort | list %}
{% for site_code in site_codes %}
{% set site_devs = all_devices | selectattr('Site', 'equalto', site_code) | list %}
{#- derived from the devices' own full_ip, not sites_by_code: CLD (its own LAN), VRK (the
   vRACK) and BRD (shares BER's reverse zone) are all deliberately absent from
   sites_by_code but still have real devices here -- and this also means the subnet
   prefix itself is derived per-site rather than hardcoded, since FRD's is
   172.16.124.0/24, not 192.168.x.0/24 like every other site #}
{% set with_ip = site_devs | selectattr('full_ip', 'ne', '') | list %}
{% set subnet_prefix = with_ip[0].full_ip.rsplit('.', 1)[0] if with_ip else '?' %}

; ── {{ site_code }}  ({{ subnet_prefix }}.0/24) ───────────────
{% for dev in site_devs | sort(attribute='HostOctet') %}
{% if dev.HostOctet != '' %}
{{ "%-45s" | format(dev.Hostname | lower) }} IN  A  {{ dev.full_ip }}{{ '   ; ' + dev.Notes if dev.Notes else '' }}
{% if dev.DNSAlias %}
{{ "%-45s" | format(dev.DNSAlias) }} IN  CNAME  {{ dev.Hostname | lower }}.{{ domain }}.   ; friendly alias, role_codes.csv's DNSAlias column
{% endif %}
{% else %}
; NO-IP  {{ dev.Hostname | lower }}{{ '  -- ' + dev.Notes if dev.Notes else '' }}
{% endif %}
{% endfor %}
{% endfor %}

; ── DHCP pool ($GENERATE) ─────────────────────────────────────
; .100–.199 per site — forward records only.
; PTR $GENERATE blocks are in each per-site reverse zone file.
; CLD (provisioning network) has no DHCP pool.
{% for site in sites_raw.list
   | rejectattr('Site', 'equalto', 'BRD')
   | rejectattr('Site', 'equalto', 'Site')
   | rejectattr('Site', 'equalto', 'CLD')
   | rejectattr('Subnet', 'equalto', 'N/A')
   | sort(attribute='Site') %}
{% set octet = site.Subnet.split('.')[2] %}
; {{ site.Site }} -- 192.168.{{ octet }}.100-199
$GENERATE 100-199 dhcp${-99,2,d}.{{ site.Site | lower }} IN A 192.168.{{ octet }}.$
{% endfor %}

; ── One-off records -- add below, DO NOT edit above ──────────
; Records added here are preserved between Ansible runs only if
; you manage them outside the template. Increment SOA serial manually.
