// ============================================================
// named.conf.local -- Example Music Limited
// {{ this_hostname }}  --  {{ domain }}
// Managed by Ansible bind9-dns.yml -- do not edit by hand
// Generated: {{ ansible_date_time.iso8601 }}
// Role: {{ dns_role | default('master') }}
{% if dns_role | default('master') == 'slave' %}
// This is a SECONDARY/REPLICA server -- every zone below is a slave of
// {{ dns_master_ip }} (EXADNSVRK001), replicated via AXFR/IXFR. Zone content
// is never generated or edited locally -- BIND9 pulls and caches it
// automatically into {{ bind_zone_dir }} the moment the master notifies or
// the refresh interval elapses. Confirmed with Robert, 2026-09-24: a real
// secondary, not a separate authoritative sub-zone and not a caching-only
// forwarder -- see docs/adding-a-new-site.md and this playbook's own
// header for the full context.
{% endif %}
//
// Forward zone:   {{ domain }}
// Reverse zones:
//   139.168.192.in-addr.arpa  -- dedicated provisioning zone
//                                (FWL WAN IPs + ancillary hosts)
//   X.168.192.in-addr.arpa    -- one per site /24 (CLD excluded)
// ============================================================

{% macro dns_zone(name, filename) -%}
zone "{{ name }}" {
{% if dns_role | default('master') == 'slave' %}
  type slave;
  masters { {{ dns_master_ip }}; };
  file "{{ bind_zone_dir }}/{{ filename }}";
{% else %}
  type master;
  file "{{ bind_zone_dir }}/{{ filename }}";
  allow-query   { any; };
  allow-transfer { {{ dns_secondary_ip | default('none') }}; };
  notify {{ 'yes' if dns_secondary_ip is defined and dns_secondary_ip else 'no' }};
{% endif %}
};
{%- endmacro %}

// ── Forward zone: {{ domain }} ───────────────────────────
{{ dns_zone(domain, 'db.' + domain) }}

// ── Reverse zone: provisioning network 192.168.139.0/24 ──────
// Dedicated zone -- FWL WAN IPs for all sites + ancillary hosts.
// NOT generated by the per-site loop.
{{ dns_zone('139.168.192.in-addr.arpa', 'db.192.168.139') }}

// ── Reverse zone: CLD LAN 192.168.69.0/24 ────────────────────
// CLD BLACK SWAN: LAN subnet is separate from the vRACK above.
// Per-site loop is excluded for CLD; this zone is hardcoded here.
{{ dns_zone('69.168.192.in-addr.arpa', 'db.192.168.69') }}

{% for site in sites | rejectattr('Site', 'equalto', 'CLD') | sort(attribute='octet') %}
// ── Reverse zone: 192.168.{{ site.octet }}.0/24  ({{ site.Site }} -- {{ site.City }}) ──
{{ dns_zone(site.octet ~ '.168.192.in-addr.arpa', 'db.192.168.' ~ site.octet) }}

{% endfor %}
