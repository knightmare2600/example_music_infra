; ============================================================
; /etc/bind/db.192.168.{{ sites_by_code[item].split('.')[2] }}
; Example Music Limited -- reverse zone
;
; Zone:    {{ sites_by_code[item].split('.')[2] }}.168.192.in-addr.arpa
; Covers:  {{ sites_by_code[item] }}  ({{ item }})
; Source:  devices.csv (single source of truth)
; Server:  EXADNSVRK001 ({{ dns_ip }})
; Managed: Ansible bind9-dns.yml Play 2
; Generated: {{ ansible_date_time.iso8601 }}
;
; PTR records generated for all devices in devices.csv with a HostOctet.
; Non-networked assets (blank HostOctet) are documented as comments.
; ============================================================

{% set site_octet = sites_by_code[item].split('.')[2] %}
$ORIGIN {{ site_octet }}.168.192.in-addr.arpa.
$TTL {{ zone_ttl }}

@   IN  SOA  {{ this_hostname }}.{{ domain }}.  hostmaster.{{ domain }}. (
              {{ zone_serial }}  ; serial
              3600       ; refresh
              900        ; retry
              604800     ; expire
              {{ zone_ttl }}        ; minimum
            )

@   IN  NS   {{ this_hostname }}.{{ domain }}.

; ── PTR records (192.168.{{ site_octet }}.x) ─────────────────
; Excludes any device with a SubnetSite override pointing elsewhere -- its real IP isn't on
; THIS site's own subnet (e.g. EXAFWLAMS001's bare hostname is now the VRK/provisioning-network
; WAN face, SubnetSite=VRK, Robert 2026-07-26 -- without this filter it would leak a bogus PTR
; in here at octet {{ site_octet }} itself, since HostOctet is reused as the site's own
; identifying position within 192.168.139.0/24, not a real position within THIS subnet).
; Generalises the pre-existing "SubnetSite not handled by the reverse-zone templates" gap
; (see generate_inventory.py's emit_devices_for_dns() docstring, 2026-07-11) -- that case was
; safe by coincidence only (the one device using it, CLD's PBX-2, never reaches this template
; at all since CLD is excluded from the per-site loop entirely); this one genuinely does.
{% set site_devs = all_devices
   | selectattr('Site', 'equalto', item)
   | rejectattr('SubnetSite', 'defined')
   | sort(attribute='HostOctet') | list %}
{% for dev in site_devs %}
{% if dev.HostOctet != '' %}
{{ "%-5s" | format(dev.HostOctet) }} IN  PTR  {{ dev.Hostname | lower }}.{{ domain }}.{{ '   ; ' + dev.Notes if dev.Notes else '' }}
{% else %}
; NO-IP  {{ dev.Hostname | lower }}{{ '  -- ' + dev.Notes if dev.Notes else '' }}
{% endif %}
{% endfor %}

; ── DHCP pool PTR ($GENERATE) ─────────────────────────────────
; .100–.199  →  dhcp01.{{ item | lower }}.{{ domain }}. through dhcp100.{{ item | lower }}.{{ domain }}.
$GENERATE 100-199 $ IN PTR dhcp${-99,2,d}.{{ item | lower }}.{{ domain }}.
