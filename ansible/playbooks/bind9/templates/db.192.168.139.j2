; ============================================================
; /etc/bind/db.192.168.139
; Example Music Limited -- provisioning network reverse zone
;
; Zone:    139.168.192.in-addr.arpa
; Covers:  192.168.139.0/24  (provisioning network)
; Server:  EXADNSVRK001 ({{ dns_ip }})
; Managed by: Ansible bind9-dns.yml
; Generated:  {{ ansible_date_time.iso8601 }}
;
; PTR records:
;   cld_black_swan_hosts, filtered to Site=VRK (DNS/PRV/FWL WAN face) below.
;   Rudder/WAC/PBX/DCs are CLD LAN-only (192.168.69.0/24) -- see db.192.168.69.j2,
;   NOT this zone. (An earlier version of this file wrongly duplicated them here
;   too, at the same host octets as their real LAN addresses -- a copy-paste
;   mistake, not a genuine second vRACK-side interface. Fixed 2026-07-08.)
;   .X   exafwl{site}001-wan  -- firewall WAN face per site
;        where X = the site's /24 third octet (from sites.csv)
;
; The -wan suffix distinguishes each firewall's provisioning-network
; address from its LAN address (exafwl{site}001 in its own subnet).
;
; This zone is NOT generated by the per-site loop. CLD's own subnet
; is 192.168.139.0/24 -- handling it here avoids a duplicate zone.
; ============================================================

$ORIGIN 139.168.192.in-addr.arpa.
$TTL {{ zone_ttl }}

@   IN  SOA  {{ this_hostname }}.{{ domain }}.  hostmaster.{{ domain }}. (
              {{ zone_serial }}  ; serial
              3600       ; refresh
              900        ; retry
              604800     ; expire
              {{ zone_ttl }}        ; minimum
            )

@   IN  NS   {{ this_hostname }}.{{ domain }}.

; ── vRACK ancillary hosts ─────────────────────────────────────
; Derived from devices.csv (see bind9-dns.yml's cld_black_swan_hosts set_fact), filtered to
; this zone's own site (VRK). DCs, Ansible node, Rudder, WAC, PBX are CLD LAN-only -- see
; db.192.168.69.j2.
{% set vrk_hosts = cld_black_swan_hosts | selectattr('site', 'equalto', 'VRK') | list %}
{% for h in vrk_hosts | sort(attribute='ip') %}
{% set host_octet = h.ip.split('.')[3] %}
{{ "%-5s" | format(host_octet) }} IN  PTR  {{ "%-50s" | format(h.name + '.' + domain + '.') }} ; {{ h.comment }}
{% endfor %}

; ── Firewall WAN PTR records ──────────────────────────────────
; 192.168.139.{octet}  ->  exafwl{site}001-wan.{{ domain }}.
; CLD special case: vRACK WAN comes from devices.csv (cld_black_swan_hosts' exafwlvrk001
; entry), not the site-octet pattern below, since CLD's own subnet is the LAN side, not the
; vRACK. Sorted by octet ascending.
{% for site in sites | sort(attribute='octet') %}
{% if site.Site == 'CLD' %}
{% set cld_wan_octet = (vrk_hosts | selectattr('name', 'equalto', 'exafwlvrk001') | map(attribute='ip') | first).split('.')[3] %}
{{ "%-5s" | format(cld_wan_octet) }} IN  PTR  {{ "%-50s" | format('exafwlcld001-wan.' + domain + '.') }} ; CLD ({{ site.City }}) -- vRACK WAN (same interface as exafwlvrk001 above)
{% else %}
{{ "%-5s" | format(site.octet) }} IN  PTR  {{ "%-50s" | format('exafwl' + site.Site | lower + '001-wan.' + domain + '.') }} ; {{ site.Site }} ({{ site.City }})
{% endif %}
{% endfor %}
