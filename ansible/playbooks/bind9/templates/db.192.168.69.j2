; ============================================================
; /etc/bind/db.192.168.69
; Example Music Limited -- CLD LAN reverse zone
;
; Zone:    69.168.192.in-addr.arpa
; Covers:  192.168.69.0/24  (CLD LAN)
; Server:  EXADNSVRK001 ({{ dns_ip }})
; Managed by: Ansible bind9-dns.yml
; Generated:  {{ ansible_date_time.iso8601 }}
;
; CLD BLACK SWAN:
;   CLD has two subnets.  This zone covers the LAN (192.168.69.0/24).
;   The vRACK (192.168.139.0/24) is handled by db.192.168.139.
;   Standard suffix_map does not apply -- CLD LAN devices are explicit.
;
; PTR records: derived from devices.csv (see bind9-dns.yml's cld_black_swan_hosts set_fact),
; filtered to this zone's own site (CLD) -- every CLD-site entry in the merged device list,
; standard-slot and real alike.
; ============================================================

$ORIGIN 69.168.192.in-addr.arpa.
$TTL {{ zone_ttl }}

@   IN  SOA  {{ this_hostname }}.{{ domain }}.  hostmaster.{{ domain }}. (
              {{ zone_serial }}  ; serial
              3600       ; refresh
              900        ; retry
              604800     ; expire
              {{ zone_ttl }}        ; minimum
            )

@   IN  NS   {{ this_hostname }}.{{ domain }}.

; ── CLD LAN PTR records ──────────────────────────────────────
{% for h in cld_black_swan_hosts | selectattr('site', 'equalto', 'CLD') | sort(attribute='ip') %}
{% set host_octet = h.ip.split('.')[3] %}
{{ "%-5s" | format(host_octet) }} IN  PTR  {{ h.name }}.{{ domain }}.   ; {{ h.comment }}
{% endfor %}
