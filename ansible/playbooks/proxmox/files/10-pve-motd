#!/bin/bash
# Example Music Limited -- PVE dynamic MOTD
# Deployed by ansible/playbooks/proxmox/playbooks/40-scripts.yml.
# Moved from bootstrap/web/proxmox/first-boot.sh on 2026-07-10 -- was
# generated inline by first-boot.sh, which now only does enough for the
# ansible user to be SSH-reachable.
GR='\033[0;32m'
CY='\033[0;36m'
YL='\033[0;33m'
WH='\033[1;37m'
NC='\033[0m'

HOSTNAME_S=$(hostname -s)
FQDN_S=$(hostname -f 2>/dev/null || echo "$HOSTNAME_S")
SITE=""; CITY=""; COUNTRY=""
ENTITY=""; NODE_IP=""
if [[ -f /etc/example-music/nodeinfo.json ]] && command -v jq &>/dev/null; then
  SITE=$(   jq -r '.site     // ""' /etc/example-music/nodeinfo.json)
  CITY=$(   jq -r '.city     // ""' /etc/example-music/nodeinfo.json)
  COUNTRY=$(jq -r '.country  // ""' /etc/example-music/nodeinfo.json)
  ENTITY=$( jq -r '.entity   // ""' /etc/example-music/nodeinfo.json)
  NODE_IP=$(jq -r '.node_ip  // ""' /etc/example-music/nodeinfo.json)
fi
# 2026-10-11, real live bug found on EXAPVEFRD001: jq's `//` alternative operator only
# fires on a JSON null/missing field, never on a genuine empty string -- nodeinfo.json's
# city/country/entity/node_ip were literally "" (a separate upstream tag-filtering bug,
# fixed in 00-preflight.yml/30-example-music.yml), so `// "Unknown"` etc. above never
# triggered and the banner printed truly blank fields instead of the intended fallback.
# Bash's own ${VAR:-default} DOES treat empty-or-unset the same way, so apply the real
# fallbacks here instead of relying on jq to catch the empty-string case.
SITE="${SITE:-UNKNOWN}"
CITY="${CITY:-Unknown}"
COUNTRY="${COUNTRY:-GB}"
ENTITY="${ENTITY:-Example Music}"
NODE_IP="${NODE_IP:-unknown}"

LAN_INFO=""
while IFS= read -r iface; do
  [[ "$iface" == "lo" ]] && continue
  IP=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2}' | head -1)
  [[ -z "$IP" ]] && continue
  LAN_INFO="${LAN_INFO}    ${GR}${iface}${NC} : ${GR}${IP}${NC}\n"
done < <(ip -o link show | awk -F': ' '{print $2}' | grep -v '@')

VM_COUNT=0; CT_COUNT=0; VM_RUNNING=0; CT_RUNNING=0
if command -v qm &>/dev/null; then
  VM_COUNT=$(qm list 2>/dev/null | tail -n +2 | wc -l)
  VM_RUNNING=$(qm list 2>/dev/null | tail -n +2 | grep -c "running" || true)
fi
if command -v pct &>/dev/null; then
  CT_COUNT=$(pct list 2>/dev/null | tail -n +2 | wc -l)
  CT_RUNNING=$(pct list 2>/dev/null | tail -n +2 | grep -c "running" || true)
fi

STORAGE_INFO=""
if command -v pvesm &>/dev/null; then
  while IFS= read -r line; do
    STORAGE_INFO="${STORAGE_INFO}    ${CY}${line}${NC}\n"
  # 2026-10-11, real live bug found on EXAPVEFRD001: pvesm status's real column order is
  # Name Type Status Total Used Available % -- this used $4 (Total)/$3 (Status)/$6
  # (Available) where it meant $5 (Used)/$4 (Total)/$7 (Percent), producing garbage like
  # "8730792 used of active (818904%)" (the literal word "active" being $3, the Status
  # column, confirmed the exact off-by-columns mapping). Fixed to the real columns.
  # Same day, second bug in the same line: pvesm status's own % column already includes
  # a literal "%" (confirmed against a real captured sample -- "99.39%", not a bare
  # number), so the printf's own explicit %% was adding a SECOND percent sign
  # ("89.23%%"). gsub strips any "%" pvesm already supplied before our printf adds one.
  done < <(pvesm status 2>/dev/null | tail -n +2 | awk '{gsub(/%/, "", $7); printf "%-20s %s used of %s (%s%%)\n", $1, $5, $4, $7}' || true)
fi

UPTIME=$(uptime -p 2>/dev/null | sed 's/up //')
LOAD=$(cut -d' ' -f1-3 /proc/loadavg)
MEM_TOTAL=$(free -m | awk '/^Mem/{print $2}')
MEM_USED=$(free -m  | awk '/^Mem/{print $3}')
DISK=$(df -h / | awk 'NR==2{print $3 " used of " $2 " (" $5 ")"}')
PVE_VER=$(pveversion 2>/dev/null | head -1 || echo "unknown")
ZFS_STATUS=$(zpool status -x 2>/dev/null || echo "ZFS unavailable")

