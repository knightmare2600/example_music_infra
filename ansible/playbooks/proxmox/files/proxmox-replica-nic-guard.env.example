# ──────────────────────────────────────────────────────────────────────────────
# proxmox-replica-nic-guard  —  credentials / config
#
# INSTRUCTIONS
#   1. Copy this file to /etc/proxmox-replica-nic-guard/auth.env
#   2. Fill in the values below
#   3. Lock down the file:
#        chown root:root /etc/proxmox-replica-nic-guard/auth.env
#        chmod 600       /etc/proxmox-replica-nic-guard/auth.env
#   4. The systemd service unit already references this path via EnvironmentFile=
#
# REQUIRED PROXMOX PERMISSIONS
#   Create a dedicated API token (Datacenter → Permissions → API Tokens) and
#   assign it the roles below on path /:
#     • PVEAuditor          (read VM configs, cluster resources, task list)
#     • VM.Config.Network   (write NIC link_down flag)
#   Alternatively use root@pam with a token for a quick start, but a least-
#   privilege token is strongly preferred in production.
# ──────────────────────────────────────────────────────────────────────────────

# Proxmox host – use the VIP/FQDN if you have an HA cluster
PROXMOX_HOST=pve.example.com

# API user that owns the token below
PROXMOX_USER=nic-guard@pam

# ── Option A: API token (recommended) ─────────────────────────────────────────
# Token name as shown in the Proxmox GUI (just the name part, not user@realm!name)
PROXMOX_TOKEN_NAME=nic-guard

# The token secret UUID shown once on creation
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Option B: password (less secure – comment out Option A above) ─────────────
# PROXMOX_PASSWORD=REPLACE_WITH_PASSWORD

# ── TLS verification ───────────────────────────────────────────────────────────
# Set to true only if your Proxmox host has a valid, trusted TLS cert.
# Self-signed certs (the Proxmox default) require false.
PROXMOX_VERIFY_SSL=false

# ── JSON log path for Zabbix pickup ───────────────────────────────────────────
# The script writes (and chmod 644s) this file after each run.
# Configure the Zabbix agent item key:  vfs.file.contents[<this path>]
NIC_GUARD_LOG=/var/log/proxmox-replica-nic-guard.json
