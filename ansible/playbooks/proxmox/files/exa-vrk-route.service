[Unit]
Description=Example Music -- static route to CLD's LAN via the VRK provisioning gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip route replace 192.168.69.0/24 via 192.168.139.69

[Install]
WantedBy=multi-user.target
